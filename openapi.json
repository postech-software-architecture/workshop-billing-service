{
  "openapi": "3.1.0",
  "info": {
    "title": "Workshop billing",
    "version": "fase-4-local",
    "description": "Rotas geradas dos controllers; seguranca e prefixo local documentados na publicacao."
  },
  "servers": [
    {
      "url": "/billing",
      "description": "Gateway local"
    }
  ],
  "paths": {
    "/api/v1/webhooks/mercado-pago": {
      "post": {
        "tags": [
          "payment-api"
        ],
        "operationId": "webhook",
        "parameters": [
          {
            "name": "X-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data.id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonNode"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/orcamentos/{id}/rejeitar": {
      "post": {
        "tags": [
          "budget-api"
        ],
        "operationId": "reject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Budget"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orcamentos/{id}/cancelar": {
      "post": {
        "tags": [
          "budget-api"
        ],
        "operationId": "cancel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Budget"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orcamentos/{id}/aprovar": {
      "post": {
        "tags": [
          "budget-api"
        ],
        "operationId": "approve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Budget"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operacoes-financeiras/{id}/retomar": {
      "post": {
        "tags": [
          "payment-api"
        ],
        "operationId": "resume",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/pagamentos/{id}": {
      "get": {
        "tags": [
          "payment-api"
        ],
        "operationId": "find",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orcamentos/{id}": {
      "get": {
        "tags": [
          "budget-api"
        ],
        "operationId": "find_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Budget"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orcamentos/{id}/notificacao": {
      "get": {
        "tags": [
          "budget-api"
        ],
        "operationId": "notification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JsonNode": {
        "type": "object"
      },
      "Budget": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "osId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "sagaId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot": {
            "$ref": "#/components/schemas/BudgetSnapshot"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDENTE",
              "APROVADO",
              "REJEITADO",
              "CANCELADO"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BudgetSnapshot": {
        "type": "object",
        "properties": {
          "orcamentoId": {
            "type": "string",
            "format": "uuid"
          },
          "orcamentoVersao": {
            "type": "integer",
            "format": "int32"
          },
          "clienteId": {
            "type": "string",
            "format": "uuid"
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "totalCentavos": {
            "type": "integer",
            "format": "int64"
          },
          "moeda": {
            "type": "string"
          }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "string"
          },
          "valorUnitarioCentavos": {
            "type": "integer",
            "format": "int64"
          },
          "totalCentavos": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}